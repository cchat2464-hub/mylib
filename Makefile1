# ============================================================================ #
#                                  VARIABLES                                   #
# ============================================================================ #

# Nombre de la librería final (la caja de herramientas)
NAME		= libft.a

# Herramientas de trabajo: compilador, banderas de seguridad, empaquetador y borrador
CC			= cc
CFLAGS		= -Wall -Wextra -Werror
AR			= ar rcs
RM			= rm -f

# Archivo de cabecera con las definiciones de todas las funciones
HEADER		= libft.h

# Lista de los planos obligatorios (tus archivos .c principales)
SRCS		= ft_isalpha.c ft_isdigit.c ft_isalnum.c ft_isascii.c \
			  ft_isprint.c ft_strlen.c ft_memset.c ft_bzero.c \
			  ft_memcpy.c ft_memmove.c ft_strlcpy.c ft_strlcat.c \
			  ft_toupper.c ft_tolower.c ft_strchr.c ft_strrchr.c \
			  ft_strncmp.c ft_memchr.c ft_memcmp.c ft_strnstr.c \
			  ft_atoi.c ft_calloc.c ft_strdup.c ft_substr.c \
			  ft_strjoin.c ft_strtrim.c ft_split.c ft_itoa.c \
			  ft_strmapi.c ft_striteri.c ft_putchar_fd.c \
			  ft_putstr_fd.c ft_putendl_fd.c ft_putnbr_fd.c

# Lista de los planos extra (las funciones de listas enlazadas)
BONUS_SRCS	= ft_lstnew.c ft_lstadd_front.c ft_lstsize.c \
			  ft_lstlast.c ft_lstadd_back.c ft_lstdelone.c \
			  ft_lstclear.c ft_lstiter.c ft_lstmap.c

# Convierte automáticamente los nombres de la lista de .c a .o (piezas ya fabricadas)
OBJS		= $(SRCS:.c=.o)
BONUS_OBJS	= $(BONUS_SRCS:.c=.o)

# ============================================================================ #
#                                    REGLAS                                    #
# ============================================================================ #

# Regla principal: lo primero que se ejecuta si solo escribes "make"
all: $(NAME)

# Empaqueta todas las piezas obligatorias (.o) dentro de libft.a
$(NAME): $(OBJS)
	$(AR) $(NAME) $(OBJS)

# Empaqueta tanto las piezas obligatorias como las bonus dentro de libft.a
bonus: $(OBJS) $(BONUS_OBJS)
	$(AR) $(NAME) $(OBJS) $(BONUS_OBJS)

# Molde mágico: toma cualquier archivo .c y lo traduce a .o usando el compilador
# $< significa "el archivo .c de entrada" y $@ significa "el archivo .o de salida"
%.o: %.c $(HEADER)
	$(CC) $(CFLAGS) -c $< -o $@

# Limpia la mesa de trabajo borrando los archivos temporales (.o), pero deja libft.a
clean:
	$(RM) $(OBJS) $(BONUS_OBJS)

# Limpieza total: ejecuta "clean" y además borra la librería libft.a
fclean: clean
	$(RM) $(NAME)

# Reinicio: borra absolutamente todo (fclean) y vuelve a fabricar desde cero (all)
re: fclean all

# Le avisa a Make que estas palabras son órdenes, no nombres de archivos reales
.PHONY: all bonus clean fclean re
